    {
      "id": 2,
      "type": "trend",
      "title": "Loss (next-token)",
      "description": "loss_ntp per optimizer step.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${ds}"
          },
          "refId": "A",
          "editorType": "sql",
          "format": 1,
          "rawSql": "SELECT step, run_id, value FROM metrics_raw WHERE name = 'loss_ntp' AND run_id IN ($run) AND value IS NOT NULL ORDER BY step",
          "queryType": "table"
        }
      ],
      "transformations": [
        {
          "id": "partitionByValues",
          "options": {
            "fields": [
              "run_id"
            ],
            "naming": {
              "asLabels": true
            }
          }
        },
        {
          "id": "joinByField",
          "options": {
            "byField": "step",
            "mode": "outer"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "showPoints": "auto",
            "axisLabel": "step"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        },
        "xField": "step"
      }
    },
