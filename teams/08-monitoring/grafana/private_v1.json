        "multi": true,
        "includeAll": true,
        "allValue": null,
        "refresh": 2,
        "sort": 1,
        "current": {},
        "query": "SELECT DISTINCT run_id FROM metrics_raw ORDER BY run_id",
        "definition": "SELECT DISTINCT run_id FROM metrics_raw ORDER BY run_id"
