          "refId": "A",
          "editorType": "sql",
          "format": 0,
          "rawSql": "SELECT time_1s AS time, concat(run_id, ' gpu', toString(rank)) AS series, mean AS value FROM gpu_telemetry_1s WHERE name = 'power_w' AND run_id IN ($run) AND $__timeFilter(time_1s) ORDER BY time_1s",
